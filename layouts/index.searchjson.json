{{- $pages := .Site.RegularPages -}}
{{- $pages = $pages | append .Site.Home -}}
{{- $pages = sort $pages "Title" -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "section": {{ $p.Section | default "home" | jsonify }},
    "description": {{ ($p.Description | default $p.Summary | plainify | truncate 140) | jsonify }}
  }
{{- end -}}
]
